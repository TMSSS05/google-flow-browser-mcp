# Copy to .env and edit. FLOW_* variables override config/flow.config.json.
# Variables set by the shell or the MCP client config win over this file.

FLOW_EXPECTED_ACCOUNT=baunhu543@gmail.com
FLOW_CHROME_PROFILE=Profile 18
FLOW_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
FLOW_CHROME_USER_DATA_DIR=C:/Users/<you>/AppData/Local/Google/Chrome/User Data
# FLOW_AUTOMATION_USER_DATA_DIR=./chrome-profile-profile-18
# FLOW_BROWSER_DATA_DIR=C:/Users/<you>/.google-flow-mcp/browser-profile
# FLOW_REFRESH_PROFILE_COPY=false
FLOW_CDP_PORT=9222
# FLOW_GUI_PORT=4321
FLOW_HEADLESS=false
# FLOW_URL=https://flow.google.com/
# FLOW_LOCALE=fr

# Telegram (bot -> channel). Bot must be admin of the channel.
TELEGRAM_BOT_TOKEN=
# @channel_username or numeric id like -1001234567890
TELEGRAM_CHAT_ID=
# Channel that hat photos come IN from (defaults to TELEGRAM_CHAT_ID). Bot must be admin there too.
TELEGRAM_INBOX_CHAT_ID=

# Gemini: notebook that cuts the hat out onto a white background
GEMINI_NOTEBOOK_URL=https://gemini.google.com/notebook/<your-notebook-id>
# GEMINI_HAT_PROMPT=...   (override the default prompt)
# GEMINI_TIMEOUT_MS=300000
# TELEGRAM_WATCH=false    (turn off the channel watcher)
